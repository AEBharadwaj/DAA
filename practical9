
#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter number of vertices: ";
    cin >> n;

    int cost[100][100];

    cout << "Enter cost adjacency matrix (0 for no edge):\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];

            if (i != j && cost[i][j] == 0)
                cost[i][j] = 9999;
        }
    }

    int visited[100] = {0};
    visited[0] = 1;

    int edges = 0, minCost = 0;

    cout << "Edges in Minimum Spanning Tree:\n";

    while (edges < n - 1) {
        int min = 9999, u = -1, v = -1;

        for (int i = 0; i < n; i++) {
            if (visited[i]) {
                for (int j = 0; j < n; j++) {
                    if (!visited[j] && cost[i][j] < min) {
                        min = cost[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        if (u == -1) {
            cout << "Graph is disconnected.\n";
            return 0;
        }

        cout << u << " - " << v << " : " << min << endl;
        minCost += min;
        visited[v] = 1;
        edges++;
    }

    cout << "Minimum cost: " << minCost << endl;

    return 0;
}
